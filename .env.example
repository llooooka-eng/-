# انسخ هذا الملف إلى .env واملأ القيم الحقيقية.
# القيم تُقرأ عبر flutter_dotenv في lib/core/config/app_config.dart.

# رابط مشروع Supabase، مثال: https://xxxxxxxx.supabase.co
SUPABASE_URL=

# مفتاح anon العمومي (publishable) من Supabase → Project Settings → API.
# آمن للتضمين في العميل لأن حمايتك الحقيقية هي Row Level Security.
SUPABASE_ANON_KEY=
